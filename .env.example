# Local development defaults to SQLite. Production refuses to start without DATABASE_URL.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
DATABASE_URL=
# Use require for external/public PostgreSQL connections. Render Blueprint uses its private connection.
DATABASE_SSL=require
ALLOWED_ORIGINS=https://appassets.trackship.ng
TRACKSHIP_PUBLIC_URL=
# Store real values privately; never in the repository or Android APK.
TRACKSHIP_IDENTITY_KEY=
# Separate owner web login; disabled until a private password of at least 14 characters is set.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
# Optional scrypt hash instead of ADMIN_PASSWORD; see docs/ADMIN-DASHBOARD.md.
ADMIN_PASSWORD_HASH=
TRACKSHIP_ADMIN_TOKEN=
PAYSTACK_SECRET_KEY=
TRACKSHIP_ENABLE_PAYOUTS=false
TRACKSHIP_SEND_JOB_SMS=false
TRACKSHIP_RIDER_CAPACITY=5
# Optional PUBLIC browser map key, restricted to the app/hosted tracking origins.
PUBLIC_MAPTILER_KEY=
# Optional compatibility SMS provider. Not needed for public tracking links.
TERMII_API_KEY=
TERMII_SENDER_ID=
# Account email verification (Resend). Store the real key privately in Render.
RESEND_API_KEY=
# No domain needed for account-only testing: recipients must use your Resend account email.
# For public signup later, replace this with a sender on your verified domain.
EMAIL_FROM="SendRack <onboarding@resend.dev>"
