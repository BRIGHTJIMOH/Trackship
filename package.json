{
  "name": "sendrack",
  "version": "0.7.0",
  "private": true,
  "description": "SendRack Android pilot and customer tracking service",
  "scripts": {
    "start": "node server/server.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "build:apk": "bash scripts/build-apk.sh",
    "test:apk": "node tests/apk-ui.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:import": "node server/migrate-sqlite.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:admin": "node tests/admin-ui.mjs",
    "build:marketing3d": "node scripts/build-marketing3d.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1",
    "three": "0.180.0"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "pg": "^8.16.3"
  }
}
