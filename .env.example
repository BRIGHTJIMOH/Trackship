# Placeholder-only inventory for the completed 0.7.1 server / Test APK.
# Values are intentionally EMPTY. This is NOT a runnable environment or a Render update.
# Preserve existing Render values, database and keys. Fill privately; never paste secrets into chat.
# Required baseline: production requires DATABASE_URL; use the existing connection/SSL setting.
NODE_ENV=
HOST=
PORT=
DATA_DIR=
DATABASE_URL=
DATABASE_SSL=
ALLOWED_ORIGINS=
# Optional override; public origin otherwise comes from Render's RENDER_EXTERNAL_URL.
TRACKSHIP_PUBLIC_URL=
# Preserve the existing key. Replacing it prevents access to saved encrypted IDs.
TRACKSHIP_IDENTITY_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
TRACKSHIP_ADMIN_TOKEN=
# Maps: optional public browser key; empty selects the existing OpenStreetMap pilot fallback.
PUBLIC_MAPTILER_KEY=
# Delivery OTP and legacy SMS authentication: both fields required for Termii.
TERMII_API_KEY=
TERMII_SENDER_ID=
# Optional offer SMS only; does NOT control delivery OTP. Preserve current true/false value.
TRACKSHIP_SEND_JOB_SMS=
TRACKSHIP_RIDER_CAPACITY=
# Existing Paystack configuration gates paid deliveries. Never change mode just to test.
PAYSTACK_SECRET_KEY=
TRACKSHIP_ENABLE_PAYOUTS=
# Signup/login email: both fields required; configure privately in Render.
RESEND_API_KEY=
EMAIL_FROM=
# GPS uses authenticated HTTPS API uploads + device permissions, not a GPS provider key.
# Released APK has no FCM/APNs integration. Do not add future push settings here.
# Render-supplied RENDER_EXTERNAL_URL / RENDER_GIT_COMMIT / RENDER_GIT_BRANCH are not hand-set here.

# Optional Android delivery push. Keep disabled until the matching native APK and server are ready.
FCM_ENABLED=
# Private server setting: full Firebase service-account JSON, never google-services.json.
FCM_SERVICE_ACCOUNT_JSON=
# Preferred on Render: path to its private Secret File, for example /etc/secrets/firebase-service-account.json.
FCM_SERVICE_ACCOUNT_FILE=
# Optional alternative to the JSON secret (all three required together).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY_BASE64=
