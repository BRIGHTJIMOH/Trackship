# Existing app settings: copy real values only into private environment settings.
NODE_ENV=development
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:REPLACE_PORT/REPLACE_DISPOSABLE_DATABASE
DATABASE_SSL=disable
ADMIN_USERNAME=REPLACE_WITH_OWNER_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_OWNER_PASSWORD

# Actual automated test variables; use disposable local services ONLY.
WALLET_TEST_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:REPLACE_PORT/REPLACE_TEST_DATABASE
SENDRACK_TEST_POSTGRES_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:REPLACE_PORT/REPLACE_TEST_DATABASE
WALLET_TEST_REDIS_PORT=REPLACE_WITH_LOOPBACK_TEST_REDIS_PORT

# Suggested explicit constructor bindings, NOT read by npm start or an activation flag.
WALLET_MOCK_WEBHOOK_SECRET=REPLACE_WITH_PRIVATE_RANDOM_MOCK_SECRET
WALLET_SECURITY_PEPPER=REPLACE_WITH_PRIVATE_RANDOM_SECURITY_PEPPER
WALLET_FINANCE_SESSION_SECRET=REPLACE_WITH_PRIVATE_RANDOM_FINANCE_SESSION_SECRET
REDIS_URL=redis://REPLACE_LOCAL_REDIS_HOST:REPLACE_LOCAL_REDIS_PORT

# Existing email adapter settings; no wallet OTP messages are sent automatically.
RESEND_API_KEY=REPLACE_WITH_PRIVATE_RESEND_KEY
EMAIL_FROM=REPLACE_WITH_RESEND_TEST_SENDER_OR_VERIFIED_DOMAIN_SENDER
# Test sender restriction: only the Resend account email can receive its test mail.
# Bank API settings are deliberately unspecified until official documentation exists.
